# ---------------------------------------------------------------------------
# Copy to .env and fill in your own values.  Never commit .env.
#
#   cp .env.example .env
#
# Note: this repository has no runtime service and no application secrets.
# Everything below is a credential or a data location needed to FETCH data.
# Nothing here is read automatically -- the notebooks currently hardcode these
# values.  Treat this file as the checklist of what you must supply, and as the
# target for issue 2.3 in docs/known-issues.md.
# ---------------------------------------------------------------------------

# --- Kaggle API ------------------------------------------------------------
# Used by HW2 (`kaggle competitions download`) and to fetch HW3 / HW4 data.
# Get these from https://www.kaggle.com/settings -> API -> Create New Token.
# That downloads a kaggle.json containing both values.
#
# The HW2 scripts expect the file itself, not these variables:
#   mkdir -p ~/.kaggle && cp kaggle.json ~/.kaggle/ && chmod 600 ~/.kaggle/kaggle.json
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# --- Google Drive file IDs -------------------------------------------------
# Not secrets, but course-supplied links that may stop working after the
# semester ends.  Override with your own copies if they break.
#
# CKIPtagger model weights, 1.88 GB, used by EX5.
# Permanent source: https://github.com/ckiplab/ckiptagger
CKIP_DATA_DRIVE_ID=1e9pHaiHCGkqQjrsBfVjUDr8VRi2_dyGT

# garments_worker_productivity.csv, used by HW1.
# Permanent source: https://archive.ics.uci.edu/dataset/597/
HW1_DATASET_DRIVE_ID=16lYjDveb2tkQ8X2Idf3s-ytjXhGbeAGp

# --- Local paths -----------------------------------------------------------
# EX5 loads CKIP weights from a mounted Google Drive path.  Change this if you
# unzip the weights somewhere else.
CKIP_DATA_PATH=/content/drive/MyDrive/機器學習概論115/data/data

# Where HW2 writes its submission file.
HW2_OUTPUT_DIR=/content/drive/MyDrive/Colab Notebooks/hw2
